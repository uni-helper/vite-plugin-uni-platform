{
  "name": "@uni-helper/vite-plugin-uni-platform",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "description": "Per-platform compilation for uni-app applications by file name suffix, using Vite",
  "author": "KeJun",
  "license": "MIT",
  "funding": [
    "https://afdian.com/a/kejun",
    "https://github.com/ModyQyW/sponsors"
  ],
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-platform.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-platform/issues",
  "keywords": [
    "uni-app",
    "uniapp",
    "uni-helper",
    "vite",
    "vite-plugin",
    "platform",
    "multi-platform",
    "h5",
    "mp-weixin"
  ],
  "maintainers": [
    {
      "name": "ModyQyW",
      "email": "wurui.dev@gmail.com",
      "url": "https://modyyw.top"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:h5": "pnpm build && pnpm -C playground run build:h5",
    "build:mp-weixin": "pnpm build && pnpm -C playground run build:mp-weixin",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "play:h5": "pnpm dev && pnpm -C playground run dev:h5",
    "play:mp-weixin": "pnpm dev && pnpm -C playground run dev:mp-weixin",
    "test": "vitest",
    "typecheck": "tsc --noEmit && pnpm -C playground run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@uni-helper/vite-plugin-uni-pages": "^0.6.1",
    "vite": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@uni-helper/vite-plugin-uni-pages": {
      "optional": true
    }
  },
  "dependencies": {
    "@uni-helper/uni-env": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uni-helper/eslint-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
