{
  "name": "@uni-helper/vite-plugin-uni-platform",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "description": "",
  "author": "KeJun",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-platform.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-platform/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:h5": "pnpm build && pnpm -C playground run build:h5",
    "build:mp-weixin": "pnpm build && pnpm -C playground run build:mp-weixin",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "play:h5": "pnpm dev && pnpm -C playground run dev:h5",
    "play:mp-weixin": "pnpm dev && pnpm -C playground run dev:mp-weixin",
    "test": "vitest --passWithNoTests",
    "typecheck": "pnpm -C playground run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@uni-helper/uni-env": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uni-helper/eslint-config": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
